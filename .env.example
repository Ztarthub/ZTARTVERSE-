# Ztartverse Environment Variables

# Supabase Configuration
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Ztartag Identity System
VITE_ZTARTAG_API_URL=https://api.ztartag.com
VITE_ZTARTAG_CLIENT_ID=your-ztartag-client-id
VITE_ZTARTAG_CLIENT_SECRET=your-ztartag-client-secret

# Ztart Ecosystem
VITE_ZTART_TOKEN_ADDRESS=0x...
VITE_ZTART_WALLET_API=https://api.zstartwallet.com

# Feature Flags
VITE_ENABLE_3D_EXPERIENCE=false
VITE_ENABLE_AR_MODE=false
VITE_ENABLE_VOICE_CHAT=false

# Development
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info
